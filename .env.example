# Export explicitly in your shell or use the systemd EnvironmentFile.
SNAP_GO_HOST=127.0.0.1
SNAP_GO_PORT=8080
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SNAP_GO_TOKEN=
SNAP_GO_SERIAL=/dev/serial/by-id/REPLACE_WITH_YOUR_ESP32
SNAP_GO_MODEL=/opt/snap-go/models/yolov8n.pt
SNAP_GO_CAMERA=0
